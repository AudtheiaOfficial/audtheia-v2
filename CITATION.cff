    given-names: Andy
repository-code: "https://github.com/AudtheiaOfficial/audtheia-v2"
url: "https://github.com/AudtheiaOfficial/audtheia-v2"
version: "2.0.0"
license: MIT
keywords:
  - biodiversity monitoring
  - environmental intelligence
  - marine protected areas
  - offline
  - provenance
  - bioacoustics
