# ============================================================================
# Audtheia V2 .gitignore
# ============================================================================

# --- Local data: rolling buffer (Pi) / authoritative record (desktop) ---
# (the double-negation pattern below keeps the directory skeleton, and its
#  .gitkeep markers, tracked while ignoring every actual data file)
data/**
!data/**/
!data/**/.gitkeep

database/**
!database/**/
!database/**/.gitkeep

reports/**
!reports/**/
!reports/**/.gitkeep

# Retraining packages written for a person to correct and train from. They are
# copies of frames and clips that already live under data/, so they are generated
# output rather than source.
exports/**
!exports/**/
!exports/**/.gitkeep

# --- Large model weights (downloaded, not bundled: see models/*/README.md) ---
*.gguf
*.hef
*.onnx
*.tflite

# BirdNET ships its label list beside its weights under a non-commercial,
# share-alike licence. Neither belongs in this permissively licensed repository,
# and setup downloads both, so the whole folder stays out of version control
# while its directory marker is kept.
models/acoustic/birdnet/*
!models/acoustic/birdnet/.gitkeep

# The GBIF taxonomic backbone (large, CC BY 4.0) is downloaded by setup into
# audtheia/resources/gbif_backbone rather than committed, so it is ignored.
audtheia/resources/gbif_backbone/

# --- Secrets / credentials ---
*.env
.env.*
**/secrets.json
**/credentials.json
config/settings.local.json
.keys/

# Throwaway configurations the test suites write beside the real settings file.
# Each suite copies config/settings.json, redirects its writable paths into a
# temp tree, and writes the copy here so the real loader can read it. They are
# normally removed when the suite finishes, but a suite that fails partway leaves
# one behind, and a station identifier or a local absolute path inside one must
# never reach the repository.
config/settings.env.test.*.json
config/settings.qc.test.*.json
config/settings.pi.acoustic.*.json
config/settings.pi.test.json

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/

# --- Logs ---
*.log
logs/
config/secrets.json
